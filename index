            loveLanguages.forEach((item) => {
                const card = document.createElement("button");
                card.type = "button";
                card.className = "glass-card p-3.5 sm:p-4 rounded-2xl text-center shadow-sm hover:shadow-md hover:scale-105 hover:bg-white transition-all duration-300 border-pink-100 group cursor-pointer focus:outline-none focus:ring-2 focus:ring-rose-300";
                card.innerHTML = `
                    <span class="text-[11px] uppercase tracking-wider text-rose-400 font-bold block mb-1">${item.lang}</span>
                    <p class="text-base sm:text-lg font-bold text-rose-900 group-hover:text-rose-600 transition-colors">${item.phrase}</p>
                `;
                card.addEventListener("click", () => {
                    card.classList.remove("lang-pulse");
                    void card.offsetWidth;
                    card.classList.add("lang-pulse");

                    langToastBox.style.opacity = "0.5";
                    setTimeout(() => {
                        langToastBox.innerHTML = `<span class="text-rose-500 font-bold">${item.phrase}</span> — ${item.note}`;
                        langToastBox.style.opacity = "1";
                    }, 120);

                    spawnBurst(6);
                });
                languagesGrid.appendChild(card);
            });

            animateParticles();
        });
    </script>
