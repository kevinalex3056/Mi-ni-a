        const canvas = document.getElementById("hearts-canvas");
        const ctx = canvas.getContext("2d");

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener("resize", resizeCanvas);
        resizeCanvas();

        const particles = [];
        const colors = ["#ff85a1", "#fbb1bd", "#f472b6", "#ffccd5", "#fb7185"];

        function createParticle(isBurst = false) {
            return {
                x: Math.random() * canvas.width,
                y: isBurst ? canvas.height + 10 : Math.random() * canvas.height,
                size: isBurst ? Math.random() * 14 + 10 : Math.random() * 11 + 7,
                speedY: isBurst ? Math.random() * 3.2 + 1.8 : Math.random() * 0.8 + 0.35,
                speedX: (Math.random() - 0.5) * (isBurst ? 2.5 : 0.6),
                opacity: isBurst ? 0.9 : Math.random() * 0.5 + 0.25,
                rotation: Math.random() * 360,
                rotationSpeed: (Math.random() - 0.5) * 1.4,
                color: colors[Math.floor(Math.random() * colors.length)],
                type: Math.random() > 0.35 ? "heart" : "petal",
                isBurst: isBurst
            };
        }

        for (let i = 0; i < 28; i++) {
            particles.push(createParticle(false));
        }

        function spawnBurst(count) {
            for (let i = 0; i < count; i++) {
                particles.push(createParticle(true));
            }
        }

        function llenarDeAmor() {
            spawnBurst(45);
            const langToastBox = document.getElementById("lang-toast-box");
            if (langToastBox) {
                langToastBox.innerHTML = `<span class="text-rose-600 font-bold">💖 ¡Gracias a Dios por ti, mi niña bonita! Te amo infinito 💖</span>`;
            }
        }

        function drawHeart(x, y, size, opacity, rotation, color) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate((rotation * Math.PI) / 180);
            ctx.globalAlpha = opacity;
            ctx.fillStyle = color;
            ctx.beginPath();
            let d = size;
            ctx.moveTo(0, d / 4);
            ctx.bezierCurveTo(0, 0, -d / 2, 0, -d / 2, d / 4);
            ctx.bezierCurveTo(-d / 2, d / 2, 0, d * 0.75, 0, d);
            ctx.bezierCurveTo(0, d * 0.75, d / 2, d / 2, d / 2, d / 4);
            ctx.bezierCurveTo(d / 2, 0, 0, 0, 0, d / 4);
            ctx.fill();
            ctx.restore();
        }

        function drawPetal(x, y, size, opacity, rotation, color) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate((rotation * Math.PI) / 180);
            ctx.globalAlpha = opacity;
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.quadraticCurveTo(size * 0.6, -size * 0.5, size, 0);
            ctx.quadraticCurveTo(size * 0.6, size * 0.5, 0, 0);
            ctx.fill();
            ctx.restore();
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.y -= p.speedY;
                p.x += p.speedX + Math.sin(p.y * 0.015) * 0.3;
                p.rotation += p.rotationSpeed;

                if (p.y < -25) {
                    if (p.isBurst) {
                        particles.splice(i, 1);
                        continue;
                    } else {
                        p.y = canvas.height + 20;
                        p.x = Math.random() * canvas.width;
                    }
                }

                if (p.type === "heart") {
                    drawHeart(p.x, p.y, p.size, p.opacity, p.rotation, p.color);
                } else {
                    drawPetal(p.x, p.y, p.size, p.opacity, p.rotation, p.color);
                }
            }

            requestAnimationFrame(animateParticles);
        }

        window.addEventListener("DOMContentLoaded", () => {
            loadTrack(0, true);

            const unlockOnce = () => {
                playSequenceFromStart();
                document.removeEventListener("pointerdown", unlockOnce);
                document.removeEventListener("click", unlockOnce);
            };
            document.addEventListener("pointerdown", unlockOnce, { once: true });
            document.addEventListener("click", unlockOnce, { once: true });

            if (btnAudioToggle) {
                btnAudioToggle.addEventListener("click", (e) => {
                    e.stopPropagation();
                    if (bgAudio.paused) {
                        playSequenceFromStart();
                    } else {
                        bgAudio.pause();
                    }
                });
            }

            if (btnAudioNext) {
                btnAudioNext.addEventListener("click", (e) => {
                    e.stopPropagation();
                    hasStartedFromZero = true;
                    playNextTrack();
                });
